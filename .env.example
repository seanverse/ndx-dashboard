# 两条链路共用同一个值，CF Worker 侧用 wrangler secret put CRON_SECRET 写入
# 生成：openssl rand -hex 32
CRON_SECRET=

# Vercel Blob Store 的公网基址，形如 https://xxxxxxxx.public.blob.vercel-storage.com
# 在 Vercel 控制台 Storage → Blob 页面可查。Vercel 不会自动注入这一项，线上必须手填。
BLOB_BASE_URL=

# 由 @vercel/blob 自动读取，本地开发不需要（会自动落到 .data/ 目录）
# 代码按「唯一后缀」匹配，所以带前缀的变量（如 NDX_BLOB_READ_WRITE_TOKEN）也能识别
BLOB_READ_WRITE_TOKEN=

# 连接 Blob 库后由 Vercel 注入；没有静态 token 时，代码改用它 + OIDC 认证
BLOB_STORE_ID=
