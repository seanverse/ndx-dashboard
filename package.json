{
  "name": "ndx-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "serve": "tsx scripts/serve.ts",
    "seed": "tsx scripts/seed.ts",
    "audit": "node scripts/audit-overflow.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify": "tsx scripts/verify-sources.ts",
    "worker:dry": "npx wrangler@4.152.0 deploy --dry-run --config worker/wrangler.toml",
    "worker:secret": "npx wrangler@4.152.0 secret put CRON_SECRET --config worker/wrangler.toml",
    "worker:deploy": "npx wrangler@4.152.0 deploy --config worker/wrangler.toml",
    "worker:tail": "npx wrangler@4.152.0 tail --config worker/wrangler.toml"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.62.7",
    "@vercel/blob": "^2.8.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vercel/node": "^5.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
